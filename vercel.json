{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*).js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/t&c/students", "destination": "/index.html" },
    { "source": "/t&c/instructors", "destination": "/index.html" },
    { "source": "/terms/students", "destination": "/index.html" },
    { "source": "/terms/instructors", "destination": "/index.html" },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
